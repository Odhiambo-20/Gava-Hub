POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=gavahub
POSTGRES_USER=gavahub
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433

REDIS_IMAGE=redis:8-alpine
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_PORT=6380

BACKEND_IMAGE=gavahub/backend:latest
FRONTEND_IMAGE=gavahub/frontend:latest
NGINX_IMAGE=nginx:1.28-alpine
HTTP_PORT=8080

SPRING_PROFILES_ACTIVE=production
GAVA_HUB_JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=https://example.com/api/v1/webhooks/mpesa
MPESA_CALLBACK_SECRET=replace-with-a-long-random-callback-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=no-reply@example.com
CONTACT_SUPPORT_EMAIL=support@example.com
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PROMETHEUS_RETENTION=30d
GRAFANA_IMAGE=grafana/grafana:12.1.0
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_ROOT_URL=http://localhost:3001
