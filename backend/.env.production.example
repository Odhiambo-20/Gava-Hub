# Configure these as secrets/environment variables in your production host.
NODE_ENV=production
PORT=8080
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
MAX_REQUEST_SIZE=22mb

# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=wihl-verify
JWT_TOKEN_TTL=8h
BCRYPT_ROUNDS=12

# cPanel same-server PostgreSQL: use localhost and DATABASE_SSL=false.
# Remote managed PostgreSQL: use the provider URL and DATABASE_SSL=true.
# URL-encode special characters in the username/password where necessary.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
DATABASE_POOL_MAX_SIZE=10
DATABASE_SSL=true

DOCUMENT_STORAGE_PROVIDER=LOCAL
DOCUMENT_LOCAL_ROOT=/var/lib/wihl-verify/documents
DOCUMENT_MAX_BYTES=20971520

PAYMENT_METHOD=COOP_PAYBILL
COOP_PAYBILL_NUMBER=REPLACE_WITH_PRODUCTION_PAYBILL
COOP_ACCOUNT_NUMBER=REPLACE_WITH_PRODUCTION_ACCOUNT
MPESA_ENVIRONMENT=production
MPESA_CALLBACK_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# SMTP is not currently used by the backend; configure when email delivery is implemented.
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
NOTIFICATION_FROM_EMAIL=info@wihlverify.org
CONTACT_SUPPORT_EMAIL=info@wihlverify.org
