# Runtime
NODE_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_SIZE=22mb

# Security (required in production — JWT_SECRET min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=wihl-verify
JWT_TOKEN_TTL=8h
BCRYPT_ROUNDS=12

# PostgreSQL (omit for in-memory local development)
# DATABASE_URL=postgresql://gavahub:gavahub@localhost:5433/gavahub
# DATABASE_POOL_MAX_SIZE=20
# DATABASE_SSL=false

# Redis (optional locally)
# REDIS_URL=redis://localhost:6380
# REDIS_HOST=localhost
# REDIS_PORT=6380
# REDIS_PASSWORD=

# Document storage
DOCUMENT_STORAGE_PROVIDER=LOCAL
DOCUMENT_LOCAL_ROOT=./data/documents

# Payments — Co-op PayBill (default) or DARAJA (M-Pesa STK)
PAYMENT_METHOD=COOP_PAYBILL
COOP_PAYBILL_NUMBER=400200
COOP_ACCOUNT_NUMBER=1195351
# MPESA_ENVIRONMENT=sandbox
# MPESA_CALLBACK_SECRET=

# Mail (required in production)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=info@wihlverify.org
CONTACT_SUPPORT_EMAIL=info@wihlverify.org
