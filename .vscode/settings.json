{
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "/usr/lib/jvm/java-17-openjdk-amd64",
      "default": true
    }
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/.output/**": true,
    "**/dist/**": true,
    "**/.tanstack/**": true,
    "**/.nitro/**": true,
    "**/.vinxi/**": true
  }
}
